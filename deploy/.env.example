# Salin menjadi deploy/.env DI STB. File .env tidak masuk Git/image.
TZ=Asia/Jakarta
SESSION_TTL_DAYS=30
# Ganti dengan origin HTTPS pilihanmu, tanpa slash akhir.
ALLOWED_ORIGINS=https://rumah.example.com
N8N_RECEIPT_OCR_URL=https://n8n.rdodev.my.id/webhook/catatan-rumah/receipt-ocr
N8N_RECEIPT_ARCHIVE_URL=https://n8n.rdodev.my.id/webhook/catatan-rumah/receipt-archive
N8N_INSIGHT_URL=https://n8n.rdodev.my.id/webhook/catatan-rumah/spending-insight
# Isi secret yang SAMA dengan credential Header Auth n8n (minimal 16 karakter).
N8N_WEBHOOK_SECRET=
