# Salin ke .env lalu sesuaikan. Jangan commit file .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/catatan-rumah.db
TZ=Asia/Jakarta
SESSION_TTL_DAYS=30
# Origin yang boleh POST/PUT/DELETE (pisahkan dengan koma)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# --- Scan nota (Langkah 4) ---
# Biarkan kosong dulu: di development, scan memakai data CONTOH (mock) agar UI bisa dicoba.
N8N_RECEIPT_OCR_URL=
N8N_RECEIPT_ARCHIVE_URL=
# Minimal 16 karakter, harus sama dengan nilai Header Auth di n8n.
# Buat di terminal: openssl rand -hex 24   (jangan commit / jangan kirim ke chat)
N8N_WEBHOOK_SECRET=
RECEIPTS_DIR=./data/receipts

# --- Analisa AI (Langkah 6) --- kosong = mode contoh di development
N8N_INSIGHT_URL=
# auto = mock (OCR & analisa) hanya bila URL webhook-nya kosong & bukan production; on/off untuk memaksa.
OCR_MOCK=auto
